# Rendered by budctl. Square-bracket expressions belong to the installer; the
# {{...}} expressions are intentionally preserved for ArgoCD's Go template.
apiVersion: argoproj.io/v1alpha1
kind: ApplicationSet
metadata:
  name: [[ .Environment ]]
  namespace: argocd
spec:
  goTemplate: true
  goTemplateOptions: ["missingkey=error"]
  generators:
    - list:
        elements:
          - name: argocd
            namespace: argocd
            repoURL: registry.bud.studio/charts
            chart: argocd
            targetRevision: "0.1.1"
            valueFiles:
              - "$values/values/argocd/secrets.[[ .Environment ]].yaml"
              - "$values/values/argocd/values.budruntime.yaml"
              - "$values/values/argocd/values.[[ .Environment ]].yaml"
          - name: dapr
            namespace: dapr-system
            repoURL: https://dapr.github.io/helm-charts
            chart: dapr
            targetRevision: "1.18.4"
            valueFiles:
              - "$values/values/dapr/values.yaml"
          - name: kafka
            namespace: kafka
            repoURL: registry.bud.studio/charts
            chart: kafka
            targetRevision: "0.1.1"
            valueFiles:
              - "example.minimal.yaml"
              - "$values/values/kafka/values.budruntime.yaml"
              - "$values/values/kafka/secrets.[[ .Environment ]].yaml"
          - name: mongodb
            namespace: mongodb
            repoURL: registry.bud.studio/charts
            chart: mongodb
            targetRevision: "0.1.1"
            valueFiles:
              - "example.minimal.yaml"
              - "$values/values/mongodb/values.budruntime.yaml"
              - "$values/values/mongodb/secrets.[[ .Environment ]].yaml"
[[ if .CertManager ]]          - name: cert-manager
            namespace: cert-manager
            repoURL: registry.bud.studio/charts
            chart: cert-manager
            targetRevision: "0.1.3"
            valueFiles:
              - "$values/values/cert-manager/values.budruntime.yaml"
[[ if .SelfSigned ]]              - "$values/values/cert-manager/values.selfsigned-ca.yaml"
[[ end ]][[ if .CertValues ]]              - "$values/values/cert-manager/values.[[ .Environment ]].yaml"
[[ end ]][[ if .CertSecrets ]]              - "$values/values/cert-manager/secrets.[[ .Environment ]].yaml"
[[ end ]][[ end ]][[ if or .CAInjection .GPUFoundry ]]          - name: kyverno
            namespace: kyverno
            repoURL: registry.bud.studio/charts
            chart: kyverno
            targetRevision: "0.0.2"
            valueFiles:
[[ if .CAInjection ]]              - "$values/values/kyverno/values.inject-ca.yaml"
[[ end ]]              - "$values/values/kyverno/values.budruntime.yaml"
[[ end ]]          - name: clickhouse
            namespace: clickhouse
            repoURL: registry.bud.studio/charts
            chart: clickhouse
            targetRevision: "0.1.1"
            valueFiles:
              - "example.minimal.yaml"
              - "$values/values/clickhouse/values.budruntime.yaml"
[[ if .GPUFoundry ]]              - "$values/values/clickhouse/values.gpu-foundry.yaml"
[[ end ]]              - "$values/values/clickhouse/secrets.[[ .Environment ]].yaml"
          - name: postgres
            namespace: postgres
            repoURL: registry.bud.studio/charts
            chart: postgres
            targetRevision: "0.1.1"
            valueFiles:
              - "example.minimal.yaml"
              - "$values/values/postgres/values.budruntime.yaml"
              - "$values/values/postgres/values.minimal.budruntime.yaml"
[[ if .GPUFoundry ]]              - "$values/values/postgres/values.gpu-foundry.yaml"
[[ end ]]              - "$values/values/postgres/secrets.[[ .Environment ]].yaml"
          - name: seaweedfs
            namespace: seaweedfs
            repoURL: registry.bud.studio/charts
            chart: seaweedfs
            targetRevision: "0.1.2"
            valueFiles:
              - "example.minimal.yaml"
              - "$values/values/seaweedfs/values.budruntime.yaml"
              - "$values/values/seaweedfs/values.[[ .Environment ]].yaml"
              - "$values/values/seaweedfs/secrets.[[ .Environment ]].yaml"
          - name: valkey
            namespace: valkey
            repoURL: registry-1.docker.io/cloudpirates
            chart: valkey
            targetRevision: "0.21.4"
            valueFiles:
              - "$values/values/valkey/values.yaml"
              - "$values/values/valkey/values.minimal.yaml"
              - "$values/values/valkey/values.budruntime.yaml"
              - "$values/values/valkey/secrets.[[ .Environment ]].yaml"
          - name: keycloak
            namespace: keycloak
            repoURL: registry.bud.studio/charts
            chart: keycloak
            targetRevision: "0.2.1"
            valueFiles:
              - "$values/values/keycloak/values.budruntime.yaml"
[[ if .GPUFoundry ]]              - "$values/values/keycloak/values.gpu-foundry.yaml"
[[ end ]]              - "$values/values/keycloak/values.[[ .Environment ]].yaml"
              - "$values/values/keycloak/secrets.[[ .Environment ]].yaml"
          - name: bud
            namespace: bud
            repoURL: registry.bud.studio/charts
            chart: bud
            targetRevision: "1.3.0"
            valueFiles:
              - "$values/values/bud/values.[[ .Environment ]].yaml"
              - "$values/values/bud/secrets.[[ .Environment ]].yaml"
          - name: opensandbox
            namespace: opensandbox-system
            repoURL: registry.bud.studio/charts
            chart: opensandbox
            targetRevision: "0.0.1"
            valueFiles:
              - "$values/values/opensandbox/secrets.[[ .Environment ]].yaml"
[[ if .BudStudio ]]          - name: bud-studio
            namespace: bud-studio
            repoURL: registry.bud.studio/charts
            chart: budagent
            targetRevision: "0.3.6"
            valueFiles:
              - "$values/values/bud-studio/values.[[ .Environment ]].yaml"
              - "$values/values/bud-studio/secrets.[[ .Environment ]].yaml"
[[ end ]][[ if .GPUFoundry ]]          - name: gpu-foundry
            # Must be gpu-foundry: the fleet reader's ClusterRoleBinding names it. The chart
            # also creates gpu-foundry-revenue, gpu-foundry-tenant-logs and
            # gpu-foundry-credentials, and its revenue Kafka objects in namespace kafka.
            namespace: gpu-foundry
            repoURL: registry.bud.studio/charts
            chart: gpu-foundry
            # The first release whose chart carries the CRDs, RBAC, namespace, policies and
            # image digests that v0.5.3 took from git.
            targetRevision: "0.5.4-rc.4"
            valueFiles:
              - "$values/values/gpu-foundry/values.budruntime.yaml"
              - "$values/values/gpu-foundry/values.minimal.yaml"
[[ if .CAInjection ]]              - "$values/values/gpu-foundry/values.inject-ca.yaml"
[[ end ]]              - "$values/values/gpu-foundry/values.[[ .Environment ]].yaml"
              - "$values/values/gpu-foundry/secrets.[[ .Environment ]].yaml"
          - name: gpu-foundry-kueue
            # Kueue is per cluster (CRDs, webhooks, an APIService), so one Application. Its
            # chart also puts one RoleBinding in kube-system.
            namespace: kueue-system
            repoURL: registry.k8s.io/kueue/charts
            chart: kueue
            targetRevision: "0.14.4"
            valueFiles:
              - "$values/values/kueue/values.yaml"
[[ end ]]  template:
    metadata:
      name: "[[ .Environment ]]-{{.name}}"
    spec:
      project: [[ .Environment ]]
      destination:
        server: https://kubernetes.default.svc
        namespace: "{{.namespace}}"
      syncPolicy:
        syncOptions:
          - CreateNamespace=true
          - ServerSideApply=true
        automated:
          enabled: false
          selfHeal: true
  templatePatch: |
    spec:
      sources:
        - repoURL: {{ .repoURL | quote }}
          chart: {{ .chart | quote }}
          targetRevision: {{ .targetRevision | quote }}
          helm:
            releaseName: "{{.name}}"
            valueFiles:
              {{- .valueFiles | toYaml | nindent 12 }}
        - repoURL: [[ quote .RepoURL ]]
          targetRevision: [[ quote .Branch ]]
          ref: values
